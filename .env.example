# Copy to .env; keep all real credentials out of Git.
DB_URL=jdbc:mysql://localhost:3306/devinsight?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
DB_USERNAME=devinsight
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ADMIN_GITHUB_LOGIN=
# Optional public repository rate-limit token. Private repositories remain unsupported.
GITHUB_TOKEN=
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
UPLOAD_DIR=./data/uploads
INTERVIEW_PER_HOUR=12
AI_CALLS_PER_DAY=150
